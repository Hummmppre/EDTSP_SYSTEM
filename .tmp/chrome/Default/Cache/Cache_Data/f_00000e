<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f2ede1" />
    <title>Admin Dashboard | EDTSP</title>

    <link rel="stylesheet" href="../css/portal.css" />
    <script src="../js/admin.js" defer></script>
    <script src="../js/admin-dashboard.js" defer></script>
    <script src="../js/portal.js" defer></script>
  </head>
  <body>
    <div class="shell" id="shell">
      <aside
        class="sidebar"
        id="sidebar"
        aria-label="Administrator portal navigation"
      >
        <a
          class="brand"
          href="dashboard.html"
          aria-label="Esperon Dairy Training"
        >
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M4 20V10.5L12 4l8 6.5V20" />
              <path d="M9 20v-5.5h6V20" />
              <path d="M9 17h6" />
            </svg>
          </span>
          <span class="brand__type">Esperon<small>Dairy training</small></span>
        </a>

        <div class="who">
          <span class="avatar">A</span>
          <span class="who__text">
            <strong>Administrator</strong>
            <small>Full access</small>
          </span>
        </div>

        <nav class="nav" aria-label="Administration">
          <p class="nav__label">Records</p>

          <a
            class="nav__link is-active"
            href="dashboard.html"
            aria-current="page"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="4" y="4" width="7" height="7" rx="1" />
              <rect x="13" y="4" width="7" height="7" rx="1" />
              <rect x="4" y="13" width="7" height="7" rx="1" />
              <rect x="13" y="13" width="7" height="7" rx="1" />
            </svg>
            <span>Dashboard</span>
          </a>

          <a class="nav__link" href="trainees.html">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="9" cy="8" r="3" />
              <path d="M3 19c.6-3 3-4.7 6-4.7s5.4 1.7 6 4.7" />
              <path d="M16 5.6a3 3 0 0 1 0 5.6" />
              <path
                d="M18.5 19c-.2-1.6-.7-2.9-1.6-3.9 2.5-.2 4.3 1.3 4.9 3.9"
              />
            </svg>
            <span>Trainees</span>
          </a>

          <a class="nav__link" href="applications.html">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M7 3.5h10A1.5 1.5 0 0 1 18.5 5v15a1.5 1.5 0 0 1-1.5 1.5H7A1.5 1.5 0 0 1 5.5 20V5A1.5 1.5 0 0 1 7 3.5Z"
              />
              <path d="M9 8.5h6M9 12h4" />
              <path d="m9 16 1.8 1.8L15 14" />
            </svg>
            <span>Applications</span>
            <span class="nav__badge" data-pending-count hidden>0</span>
          </a>

          <a class="nav__link" href="programs.html">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 4 3.5 8.5 12 13l8.5-4.5Z" />
              <path d="m3.5 12.5 8.5 4.5 8.5-4.5" />
              <path d="m3.5 16.5 8.5 4.5 8.5-4.5" />
            </svg>
            <span>Programs</span>
          </a>

          <a class="nav__link" href="assessments.html">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="5" y="5" width="14" height="16" rx="2" />
              <path d="M9 5V3.5h6V5" />
              <path d="m9 13 2 2 4-4" />
            </svg>
            <span>Assessments</span>
          </a>

          <a class="nav__link" href="payments.html">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 3h12v18l-2-1.5L14 21l-2-1.5L10 21l-2-1.5L6 21Z" />
              <path d="M9 8h6M9 12h6" />
            </svg>
            <span>Payments</span>
          </a>

          <a class="nav__link" href="cow-maintenance.html">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 9V7.5A2.5 2.5 0 0 1 8.5 5" />
              <path d="M18 9V7.5A2.5 2.5 0 0 0 15.5 5" />
              <path d="M6 8c0 6.5 2.7 11 6 11s6-4.5 6-11" />
              <path d="M10 14h4" />
              <path d="M10.5 10h.01M13.5 10h.01" />
            </svg>
            <span>Cow maintenance</span>
          </a>

          <p class="nav__label">Session</p>

          <button
            class="nav__link nav__link--quiet nav__link--button"
            id="logoutBtn"
            type="button"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4" />
              <path d="M10 12H3" />
              <path d="m6 9-3 3 3 3" />
            </svg>
            <span>Log out</span>
          </button>
          <a class="nav__link" href="settings.html">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="3" />
              <path
                d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.7 1.7-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.1h-2.4v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L8 17l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.6-1H6.7v-2.4h.1a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L8 8.6l1.7-1.7.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.6v-.1h2.4v.1a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1 1.7 1.7-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.1V14h-.1a1.7 1.7 0 0 0-1.6 1Z"
              />
            </svg>
            <span>Settings</span>
          </a>
        </nav>

        <p class="sidebar__foot">
          Esperon Dairy Training
          <span>Administrator portal · 2026</span>
        </p>
      </aside>

      <div class="scrim" aria-hidden="true"></div>

      <div class="main">
        <header class="topbar">
          <div class="topbar__left">
            <button
              class="icon-btn"
              id="sidebarToggle"
              type="button"
              aria-label="Toggle navigation"
              aria-controls="sidebar"
              aria-expanded="true"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16" />
              </svg>
            </button>

            <p class="topbar__where">
              <span>Administration</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m9 6 6 6-6 6" />
              </svg>
              <strong>Dashboard</strong>
            </p>
          </div>

          <div class="topbar__user">
            <span>Administrator</span>
            <span class="avatar avatar--sm">A</span>
          </div>
        </header>

        <main class="page">
          <header class="page__head">
            <div>
              <h1>Administrator dashboard</h1>
              <p class="page__deck">
                Live figures for every part of the portal — trainees,
                applications, programs, assessments, payments, and animal care —
                before the next training day.
              </p>
            </div>
            <p
              class="state state--inline"
              id="dashboardFeedback"
              role="status"
              hidden
            ></p>
          </header>

          <section class="ledger" aria-label="Administration summary">
            <a class="ledger__cell" href="trainees.html">
              <span class="ledger__label">Total trainees</span>
              <strong class="ledger__value" id="totalTrainees">0</strong>
              <span class="ledger__note">Registered participants</span>
            </a>

            <a class="ledger__cell" href="trainees.html">
              <span class="ledger__label">Active trainees</span>
              <strong class="ledger__value" id="activeTrainees">0</strong>
              <span class="ledger__note">Currently in training</span>
            </a>

            <a class="ledger__cell" href="assessments.html">
              <span class="ledger__label">Total assessments</span>
              <strong class="ledger__value" id="totalAssessments">0</strong>
              <span class="ledger__note">Assigned to date</span>
            </a>

            <a class="ledger__cell" href="assessments.html">
              <span class="ledger__label">Pending assessments</span>
              <strong class="ledger__value" id="pendingAssessments">0</strong>
              <span class="ledger__note"
                >Pending or completed, not graded yet</span
              >
            </a>
          </section>

          <section class="grid grid--split" aria-label="Pages overview">
            <section
              class="panel"
              aria-labelledby="overview-applications-title"
            >
              <header class="panel__head">
                <h2 id="overview-applications-title">Applications</h2>
                <a class="text-link" href="applications.html"
                  >Review applications</a
                >
              </header>

              <dl class="facts">
                <div>
                  <dt>Awaiting a decision</dt>
                  <dd id="overviewPendingApplications">—</dd>
                </div>
                <div>
                  <dt>Approved</dt>
                  <dd id="overviewApprovedApplications">—</dd>
                </div>
                <div>
                  <dt>Rejected</dt>
                  <dd id="overviewRejectedApplications">—</dd>
                </div>
              </dl>

              <p
                class="state state--inline"
                id="overviewApplicationsState"
                role="status"
                hidden
              ></p>
            </section>

            <section class="panel" aria-labelledby="overview-programs-title">
              <header class="panel__head">
                <h2 id="overview-programs-title">Programs &amp; batches</h2>
                <a class="text-link" href="programs.html">Manage programs</a>
              </header>

              <dl class="facts">
                <div>
                  <dt>Open programs</dt>
                  <dd id="overviewOpenPrograms">—</dd>
                </div>
                <div>
                  <dt>Open batches</dt>
                  <dd id="overviewOpenBatches">—</dd>
                </div>
                <div>
                  <dt>Slots remaining</dt>
                  <dd id="overviewSlotsRemaining">—</dd>
                </div>
              </dl>

              <p
                class="state state--inline"
                id="overviewProgramsState"
                role="status"
                hidden
              ></p>
            </section>

            <section class="panel" aria-labelledby="overview-assessments-title">
              <header class="panel__head">
                <h2 id="overview-assessments-title">Assessments</h2>
                <a class="text-link" href="assessments.html"
                  >Open assessments</a
                >
              </header>

              <dl class="facts">
                <div>
                  <dt>Awaiting grade</dt>
                  <dd id="overviewAwaitingAssessments">—</dd>
                </div>
                <div>
                  <dt>Graded</dt>
                  <dd id="overviewGradedAssessments">—</dd>
                </div>
                <div>
                  <dt>Average score</dt>
                  <dd id="overviewAverageScore">—</dd>
                </div>
              </dl>

              <p
                class="state state--inline"
                id="overviewAssessmentsState"
                role="status"
                hidden
              ></p>
            </section>

            <section class="panel" aria-labelledby="overview-payments-title">
              <header class="panel__head">
                <h2 id="overview-payments-title">Payments</h2>
                <a class="text-link" href="payments.html">Open payments</a>
              </header>

              <dl class="facts">
                <div>
                  <dt>Collected</dt>
                  <dd id="overviewCollected">—</dd>
                </div>
                <div>
                  <dt>Outstanding</dt>
                  <dd id="overviewOutstanding">—</dd>
                </div>
                <div>
                  <dt>Fully paid trainees</dt>
                  <dd id="overviewFullyPaid">—</dd>
                </div>
              </dl>

              <p
                class="state state--inline"
                id="overviewPaymentsState"
                role="status"
                hidden
              ></p>
            </section>

            <section class="panel" aria-labelledby="overview-cows-title">
              <header class="panel__head">
                <h2 id="overview-cows-title">Cow maintenance</h2>
                <a class="text-link" href="cow-maintenance.html"
                  >Open cow maintenance</a
                >
              </header>

              <dl class="facts">
                <div>
                  <dt>Animals on record</dt>
                  <dd id="overviewTotalCows">—</dd>
                </div>
                <div>
                  <dt>Under observation</dt>
                  <dd id="overviewObservationCows">—</dd>
                </div>
                <div>
                  <dt>Under treatment</dt>
                  <dd id="overviewTreatmentCows">—</dd>
                </div>
                <div>
                  <dt>Care tasks pending</dt>
                  <dd id="overviewPendingActivities">—</dd>
                </div>
              </dl>

              <p
                class="state state--inline"
                id="overviewCowsState"
                role="status"
                hidden
              ></p>
            </section>

            <section class="panel" aria-labelledby="overview-settings-title">
              <header class="panel__head">
                <h2 id="overview-settings-title">System settings</h2>
                <a class="text-link" href="settings.html">Open settings</a>
              </header>

              <dl class="facts">
                <div>
                  <dt>Google sign-in</dt>
                  <dd id="overviewGoogleAuth">—</dd>
                </div>
                <div>
                  <dt>reCAPTCHA</dt>
                  <dd id="overviewRecaptcha">—</dd>
                </div>
                <div>
                  <dt>Email notifications</dt>
                  <dd id="overviewEmail">—</dd>
                </div>
                <div>
                  <dt>Google Calendar</dt>
                  <dd id="overviewCalendar">—</dd>
                </div>
                <div>
                  <dt>Calendar account</dt>
                  <dd>
                    <span id="overviewCalendarAccount">—</span>
                    <a
                      class="text-link"
                      href="settings.html"
                      aria-label="Manage the Google Calendar connection in settings"
                      >Manage</a
                    >
                  </dd>
                </div>
              </dl>

              <p
                class="state state--inline"
                id="overviewSettingsState"
                role="status"
                hidden
              ></p>
            </section>
          </section>

          <section class="panel" aria-labelledby="recent-title">
            <header class="panel__head">
              <h2 id="recent-title">Recent assessments</h2>
              <a class="text-link" href="assessments.html">All assessments</a>
            </header>

            <div
              class="table-wrap"
              tabindex="0"
              role="region"
              aria-label="Recent assessments table"
            >
              <table class="data-table">
                <thead>
                  <tr>
                    <th scope="col">Assessment</th>
                    <th scope="col">Trainee</th>
                    <th scope="col">Date</th>
                    <th scope="col" class="num">Score</th>
                    <th scope="col">Status</th>
                  </tr>
                </thead>

                <tbody id="recentAssessments"></tbody>
              </table>
            </div>

            <p class="state state--inline" id="recentAssessmentsEmpty" hidden>
              No assessments recorded yet.
            </p>
          </section>

          <footer class="page__foot">
            <span>© 2026 Esperon Dairy Training Administrator Portal.</span>
            <span>Figures are read live from the training database.</span>
          </footer>
        </main>
      </div>
    </div>

    <div
      class="admin-modal"
      id="adminLogoutModal"
      data-portal-modal
      role="dialog"
      aria-modal="true"
      aria-labelledby="adminLogoutTitle"
    >
      <div class="admin-modal-content">
        <div class="modal-heading">
          <div>
            <h2 id="adminLogoutTitle">Log out?</h2>
            <p>Are you sure you want to log out of the admin portal?</p>
          </div>
          <button
            class="modal-close"
            id="closeAdminLogoutModal"
            type="button"
            aria-label="Cancel logout"
          >
            ×
          </button>
        </div>
        <div class="modal-actions">
          <button class="btn btn--ghost" id="cancelAdminLogout" type="button">
            Stay logged in
          </button>
          <button
            class="btn btn--primary"
            id="confirmAdminLogout"
            type="button"
          >
            Log out
          </button>
        </div>
      </div>
    </div>
  </body>
</html>
