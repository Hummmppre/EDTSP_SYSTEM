# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored — never commit it.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-string
PORT=5000
NODE_ENV=development

# Comma-separated origins allowed to call the API cross-origin.
# Leave empty: the app serves the frontend from the same origin.
CORS_ORIGINS=

# Optional — receipt image uploads. Without it the payment form still works
# with a reference number only.
UPLOADTHING_TOKEN=
